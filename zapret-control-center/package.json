{
  "name": "zapret-control-center",
  "version": "1.0.0",
  "description": "Zapret Control Center - GUI controller for the zapret DPI-bypass tool on Windows 10/11",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable -c.win.target=portable -c.win.requestedExecutionLevel=requireAdministrator"
  },
  "keywords": ["zapret", "gui", "windows", "dpi", "bypass"],
  "author": "",
  "license": "ISC",
  "build": {
    "appId": "com.github.zapret-control-center",
    "productName": "Zapret Control Center",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "icon.png",
      "target": "portable",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "portable": {
      "artifactName": "ZapretControlCenter.exe"
    }
  },
  "dependencies": {
    "node-fetch": "^2.7.0",
    "sudo-prompt": "^9.2.1",
    "win-ca": "^3.5.1"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  }
}
