def download_and_update_zapret(zapret_path, zip_url, progress_callback=None):
    try:
        zapret_path = Path(zapret_path)
        if not zapret_path.exists():
            return False, f"Папка не найдена: {zapret_path}"

        if progress_callback:
            progress_callback("Остановка всех процессов...", 5)
        
        stop_all_zapret_processes()

        user_files = []
        lists_path = zapret_path / "lists"
        if lists_path.exists():
            for f in lists_path.glob("*-user.txt"):
                user_files.append((f, f.read_text(encoding="utf-8", errors="ignore")))

        settings_backup = None
        if SETTINGS_FILE.exists():
            settings_backup = SETTINGS_FILE.read_text(encoding="utf-8")

        scores_backup = None
        if SCORES_FILE.exists():
            scores_backup = SCORES_FILE.read_text(encoding="utf-8")

        if progress_callback:
            progress_callback("Скачивание обновления...", 20)

        temp_dir = tempfile.mkdtemp()
        zip_path = Path(temp_dir) / "zapret_update.zip"

        req = Request(zip_url, headers={"User-Agent": "ZapretControlCenter/2.0"})
        with urlopen(req, timeout=30) as resp:
            with open(zip_path, "wb") as f:
                total = int(resp.headers.get("Content-Length", 0))
                downloaded = 0
                chunk_size = 8192
                while True:
                    chunk = resp.read(chunk_size)
                    if not chunk:
                        break
                    f.write(chunk)
                    downloaded += len(chunk)
                    if total > 0 and progress_callback:
                        percent = 20 + int((downloaded / total) * 60)
                        progress_callback(f"Скачивание... {int(downloaded/total*100)}%", percent)

        if progress_callback:
            progress_callback("Распаковка...", 85)

        extract_dir = Path(temp_dir) / "extract"
        extract_dir.mkdir()
        with zipfile.ZipFile(zip_path, "r") as zf:
            zf.extractall(extract_dir)

        content_dir = extract_dir
        subdirs = [d for d in extract_dir.iterdir() if d.is_dir()]
        if len(subdirs) == 1:
            if (subdirs[0] / "service.bat").exists():
                content_dir = subdirs[0]

        if progress_callback:
            progress_callback("Установка...", 90)

        for item in content_dir.iterdir():
            if item.name == "lists":
                continue
            dest = zapret_path / item.name
            if item.is_dir():
                if dest.exists():
                    shutil.rmtree(dest)
                shutil.copytree(item, dest)
            else:
                shutil.copy2(item, dest)

        lists_path.mkdir(parents=True, exist_ok=True)
        for f, content in user_files:
            f.write_text(content, encoding="utf-8")

        if settings_backup:
            SETTINGS_FILE.write_text(settings_backup, encoding="utf-8")
        if scores_backup:
            SCORES_FILE.write_text(scores_backup, encoding="utf-8")

        shutil.rmtree(temp_dir, ignore_errors=True)

        if progress_callback:
            progress_callback("Готово!", 100)

        return True, f"Обновление установлено в {zapret_path}"
    except Exception as e:
        return False, f"Ошибка обновления: {e}"

class ZapretManager:
    def __init__(self, zapret_path):
        self.path = Path(zapret_path)
        self.service_bat = self.path / "service.bat"
        self.bin_path = self.path / "bin"
        self.lists_path = self.path / "lists"
        self.utils_path = self.path / "utils"
        self.current_standalone = None
        self.current_strategy_path = None
        self.current_strategy_name = None

    def is_valid(self):
        return self.path.exists() and self.service_bat.exists()

    def find_strategies(self):
        strategies = []
        if not self.path.exists():
            return strategies
        files = list(self.path.glob("general*.bat"))

        def sort_key(p):
            name = p.stem.lower()
            if name == "general":
                return (0, 0, name)
            m = re.search(r"alt\s*(\d+)", name, re.I)
            if m:
                return (1, int(m.group(1)), name)
            if "fake" in name:
                return (2, 0, name)
            if "simple" in name:
                return (3, 0, name)
            if "exp" in name:
                return (4, 0, name)
            return (5, 0, name)

        files.sort(key=sort_key)
        for f in files:
            name = f.stem
            short = name
            if name.lower().startswith("general"):
                short = name[7:].strip(" ()") or "GENERAL"
                short = short.upper()
            strategies.append({
                "name": short, "full_name": name, "path": f,
                "filename": f.name, "score": None, "score_detail": "",
            })
        return strategies

    # ========== РАБОТА С USER-СПИСКАМИ ==========
    def _get_user_list_path(self):
        """Возвращает путь к list-general-user.txt"""
        self.lists_path.mkdir(parents=True, exist_ok=True)
        return self.lists_path / "list-general-user.txt"

    def _read_user_list(self):
        """Читает содержимое list-general-user.txt"""
        path = self._get_user_list_path()
        if not path.exists():
            return []
        try:
            content = path.read_text(encoding="utf-8", errors="ignore")
            return [line.strip() for line in content.splitlines() 
                    if line.strip() and not line.strip().startswith("#")]
        except Exception:
            return []

    def _write_user_list(self, domains):
        """Записывает домены в list-general-user.txt с сохранением комментариев"""
        path = self._get_user_list_path()
        try:
            # Сохраняем старые комментарии и пользовательские домены
            existing = []
            if path.exists():
                content = path.read_text(encoding="utf-8", errors="ignore")
                for line in content.splitlines():
                    if line.strip().startswith("#") or not line.strip():
                        existing.append(line)
            
            # Формируем новый контент
            new_content = []
            # Добавляем комментарии
            new_content.append("# user list")
            new_content.append("# ===== ДОМЕНЫ ДЛЯ ОБХОДА =====")
            
            # Добавляем существующие комментарии
            for line in existing:
                if line not in new_content:
                    new_content.append(line)
            
            # Добавляем домены
            for domain in sorted(set(domains)):
                if domain and not domain.startswith("#"):
                    new_content.append(domain)
            
            path.write_text("\n".join(new_content) + "\n", encoding="utf-8")
            return True
        except Exception as e:
            print(f"Ошибка записи user-list: {e}")
            return False

    def update_domains_in_user_list(self, domains_to_add, add=True):
        """Добавляет или удаляет домены из list-general-user.txt"""
        current = self._read_user_list()
        
        if add:
            # Добавляем только те, которых нет
            for d in domains_to_add:
                if d not in current:
                    current.append(d)
        else:
            # Удаляем
            current = [d for d in current if d not in domains_to_add]
        
        return self._write_user_list(current)

    def is_domain_in_user_list(self, domain):
        """Проверяет, есть ли домен в user-списке"""
        current = self._read_user_list()
        return domain in current

    def get_user_list_content(self):
        """Возвращает содержимое user-списка для отображения"""
        path = self._get_user_list_path()
        if path.exists():
            try:
                return path.read_text(encoding="utf-8", errors="ignore")
            except Exception:
                return ""
        return ""

    # ========== ПЕРЕЗАПУСК СТРАТЕГИИ ==========
    def restart_current_strategy(self):
        """Универсальный перезапуск текущей стратегии (служба или ручной запуск)"""
        status = self.get_status()
        
        # Проверяем, что вообще что-то запущено
        if not status["service_running"] and not status["winws_running"]:
            return False, "Ничего не запущено"

        # Если запущена служба
        if status["service_running"]:
            # Перезапускаем службу
            try:
                subprocess.run('net stop zapret', shell=True, capture_output=True, timeout=10)
                time.sleep(0.5)
                subprocess.run('net start zapret', shell=True, capture_output=True, timeout=10)
                return True, "Служба перезапущена"
            except Exception as e:
                return False, f"Ошибка перезапуска службы: {e}"

        # Если запущен ручной процесс
        if status["winws_running"]:
            # Останавливаем и запускаем заново
            try:
                subprocess.run('taskkill /IM winws.exe /F', shell=True, capture_output=True, timeout=5)
                time.sleep(0.5)
                
                # Запускаем сохранённую стратегию
                if self.current_strategy_path:
                    return self._start_strategy_by_path(self.current_strategy_path)
                else:
                    # Если стратегия не сохранена, пробуем запустить general.bat
                    general = self.path / "general.bat"
                    if general.exists():
                        return self._start_strategy_by_path(general)
                    return False, "Не найдена стратегия для перезапуска"
            except Exception as e:
                return False, f"Ошибка перезапуска: {e}"

        return False, "Неизвестный статус"

    def _start_strategy_by_path(self, strategy_path):
        """Запускает стратегию по пути"""
        try:
            args = self.parse_winws_args(strategy_path)
            winws = self.bin_path / "winws.exe"
            if args and winws.exists():
                subprocess.Popen(
                    f'"{winws}" {args}', shell=True, cwd=str(self.bin_path),
                    creationflags=CREATE_NO_WINDOW,
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                )
                self.current_standalone = strategy_path.stem
                self.current_strategy_path = strategy_path
                return True, f"Запущена: {strategy_path.name}"
            else:
                subprocess.Popen(
                    f'cmd /c "cd /d "{self.path}" && "{strategy_path}""',
                    shell=True, creationflags=CREATE_NO_WINDOW,
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                )
                self.current_standalone = strategy_path.stem
                self.current_strategy_path = strategy_path
                return True, f"Запущена: {strategy_path.name}"
        except Exception as e:
            return False, f"Ошибка: {e}"

    # ========== ОСТАЛЬНЫЕ МЕТОДЫ ==========
    def get_game_filter_mode(self):
        flag = self.utils_path / "game_filter.enabled"
        if not flag.exists():
            return "off"
        try:
            mode = flag.read_text(encoding="utf-8", errors="ignore").strip().lower()
            if mode in ("all", "tcp", "udp"):
                return mode
        except Exception:
            pass
        return "off"

    def set_game_profile(self, enabled):
        flag = self.utils_path / "game_filter.enabled"
        self.utils_path.mkdir(parents=True, exist_ok=True)
        if enabled:
            flag.write_text("all\n", encoding="utf-8")
        elif flag.exists():
            try:
                flag.unlink()
            except Exception:
                pass

    def get_game_filter_values(self):
        mode = self.get_game_filter_mode()
        if mode == "all":
            return "1024-65535", "1024-65535"
        if mode == "tcp":
            return "1024-65535", "12"
        if mode == "udp":
            return "12", "1024-65535"
        return "12", "12"

    def get_ipset_mode(self):
        flag = self.utils_path / "ipset_mode.txt"
        if flag.exists():
            try:
                v = flag.read_text(encoding="utf-8", errors="ignore").strip().lower()
                if v in ("none", "loaded", "any"):
                    return v
            except Exception:
                pass
        return "none"

    def set_ipset_mode(self, mode):
        self.utils_path.mkdir(parents=True, exist_ok=True)
        (self.utils_path / "ipset_mode.txt").write_text(mode + "\n", encoding="utf-8")

    def parse_winws_args(self, strategy_path):
        try:
            text = strategy_path.read_text(encoding="utf-8", errors="ignore")
        except Exception:
            try:
                text = strategy_path.read_text(encoding="cp866", errors="ignore")
            except Exception:
                return None
        text = re.sub(r"\^\s*\r?\n\s*", " ", text)
        m = re.search(
            r'(?:start\s+[^\n]*?)?["\']?%BIN%winws\.exe["\']?\s+(.*)',
            text, re.IGNORECASE | re.DOTALL
        )
        if not m:
            m = re.search(r'winws\.exe["\']?\s+(.*)', text, re.IGNORECASE | re.DOTALL)
            if not m:
                return None
        args = m.group(1).strip()
        args = re.split(r'\n\s*(?:@?echo|call |exit |pause|goto |::)', args, maxsplit=1)[0]
        args = " ".join(args.split())
        bin_str = str(self.bin_path).replace("/", "\\")
        if not bin_str.endswith("\\"):
            bin_str += "\\"
        lists_str = str(self.lists_path).replace("/", "\\")
        if not lists_str.endswith("\\"):
            lists_str += "\\"
        game_tcp, game_udp = self.get_game_filter_values()
        args = args.replace("%BIN%", bin_str).replace("%LISTS%", lists_str)
        args = args.replace("%GameFilterTCP%", game_tcp).replace("%GameFilterUDP%", game_udp)
        args = args.replace("%GameFilter%", "1024-65535" if game_tcp != "12" else "12")
        return args.strip()

    def install_as_service(self, strategy):
        args = self.parse_winws_args(strategy["path"])
        if not args:
            return False, "Не удалось разобрать аргументы winws.exe"
        winws = self.bin_path / "winws.exe"
        if not winws.exists():
            return False, f"Не найден: {winws}"
        self.remove_service(silent=True)
        self.current_standalone = None
        self.current_strategy_path = None
        try:
            ps = f'''
$bin = '{winws}'
$args = @'
{args}
'@
$binPath = "`"$bin`" $args"
sc.exe delete zapret 2>$null | Out-Null
sc.exe create zapret binPath= $binPath DisplayName= "zapret" start= auto | Out-Null
sc.exe description zapret "Zapret DPI bypass software" | Out-Null
sc.exe start zapret | Out-Null
'''
            run_hidden(["powershell", "-NoProfile", "-Command", ps], timeout=35, shell=False)
            run_hidden(
                f'reg add "HKLM\\System\\CurrentControlSet\\Services\\zapret" '
                f'/v zapret-discord-youtube /t REG_SZ /d "{strategy["full_name"]}" /f'
            )
            time.sleep(1.8)
            st = self.get_status()
            if st["service_running"] or st["winws_running"]:
                self.current_strategy_path = strategy["path"]
                self.current_strategy_name = strategy["name"]
                return True, f"Служба установлена\nСтратегия: {strategy['name']}"
            return True, "Служба создана. Проверь статус."
        except Exception as e:
            return False, f"Ошибка: {e}"

    def get_status(self):
        result = {
            "service_running": False, "service_strategy": None,
            "winws_running": False, "windivert_ok": False, "active_name": None,
        }
        try:
            out = run_hidden('sc query "zapret"').stdout or ""
            if "RUNNING" in out:
                result["service_running"] = True
        except Exception:
            pass
        try:
            out = run_hidden(
                'reg query "HKLM\\System\\CurrentControlSet\\Services\\zapret" /v zapret-discord-youtube'
            ).stdout or ""
            for line in out.splitlines():
                if "REG_SZ" in line:
                    parts = line.split("REG_SZ", 1)
                    if len(parts) == 2:
                        result["service_strategy"] = parts[1].strip()
                        break
        except Exception:
            pass
        try:
            out = run_hidden('tasklist /FI "IMAGENAME eq winws.exe"').stdout or ""
            if "winws.exe" in out.lower():
                result["winws_running"] = True
        except Exception:
            pass
        if result["service_running"] and result["service_strategy"]:
            result["active_name"] = result["service_strategy"]
        elif result["winws_running"] and self.current_standalone:
            result["active_name"] = self.current_standalone
        elif result["winws_running"]:
            result["active_name"] = "standalone"
        return result

    def stop_all(self):
        for cmd in ['net stop zapret', 'taskkill /IM winws.exe /F',
                    'net stop WinDivert', 'net stop WinDivert14']:
            run_hidden(cmd, timeout=12)
        self.current_standalone = None
        return "Обход остановлен"

    def remove_service(self, silent=False):
        for cmd in ['net stop zapret', 'sc delete zapret', 'taskkill /IM winws.exe /F',
                    'net stop WinDivert', 'sc delete WinDivert',
                    'net stop WinDivert14', 'sc delete WinDivert14']:
            run_hidden(cmd, timeout=10)
        self.current_standalone = None
        self.current_strategy_path = None
        return "" if silent else "Службы удалены"

    def start_strategy(self, strategy):
        self.current_strategy_path = strategy["path"]
        self.current_strategy_name = strategy["name"]
        args = self.parse_winws_args(strategy["path"])
        winws = self.bin_path / "winws.exe"
        if args and winws.exists():
            try:
                subprocess.Popen(
                    f'"{winws}" {args}', shell=True, cwd=str(self.bin_path),
                    creationflags=CREATE_NO_WINDOW,
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                )
                self.current_standalone = strategy["name"]
                return f"Запущена: {strategy['name']}"
            except Exception as e:
                return f"Ошибка: {e}"
        try:
            subprocess.Popen(
                f'cmd /c "cd /d "{self.path}" && "{strategy["path"]}""',
                shell=True, creationflags=CREATE_NO_WINDOW,
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            )
            self.current_standalone = strategy["name"]
            return f"Запущена: {strategy['name']}"
        except Exception as e:
            return f"Ошибка: {e}"

    def open_service_menu(self):
        try:
            subprocess.Popen(
                f'cmd /c "cd /d "{self.path}" && "{self.service_bat}""',
                shell=True, creationflags=subprocess.CREATE_NEW_CONSOLE
            )
            return "Открыто service.bat"
        except Exception as e:
            return str(e)

    def load_test_targets(self):
        tfile = self.utils_path / "targets.txt"
        if not tfile.exists():
            return [
                ("DiscordMain", "https://discord.com"),
                ("YouTubeWeb", "https://www.youtube.com"),
                ("CloudflareWeb", "https://www.cloudflare.com"),
                ("GoogleMain", "https://www.google.com"),
            ]
        try:
            text = tfile.read_text(encoding="utf-8", errors="ignore")
        except Exception:
            return []
        targets = []
        for line in text.splitlines():
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            m = re.match(r'(\w+)\s*=\s*"([^"]+)"', line)
            if m:
                targets.append((m.group(1), m.group(2)))
        return targets

    def test_connectivity(self, timeout=5.0, stop_flag=None):
        targets = self.load_test_targets()
        ok, results = 0, []
        for name, val in targets:
            if stop_flag and stop_flag[0]:
                break
            if val.upper().startswith("PING:"):
                ip = val.split(":", 1)[1].strip()
                try:
                    r = run_hidden(f'ping -n 1 -w 2000 {ip}', timeout=5)
                    success = r.returncode == 0 and "TTL=" in (r.stdout or "").upper()
                    if success:
                        ok += 1
                    results.append((name, success, "ping"))
                except Exception:
                    results.append((name, False, "ping fail"))
            else:
                try:
                    req = Request(val, headers={"User-Agent": "Mozilla/5.0"})
                    with urlopen(req, timeout=timeout) as resp:
                        code = resp.getcode()
                        if 200 <= code < 400:
                            ok += 1
                            results.append((name, True, code))
                        else:
                            results.append((name, False, code))
                except Exception as e:
                    results.append((name, False, str(e)[:35]))
        return ok, len(targets), results

    def list_user_files(self):
        self.lists_path.mkdir(parents=True, exist_ok=True)
        for name in ["list-general-user.txt", "list-exclude-user.txt", "ipset-exclude-user.txt"]:
            fp = self.lists_path / name
            if not fp.exists():
                fp.write_text("# user list\n", encoding="utf-8")
        return sorted(self.lists_path.glob("*-user.txt"))

    def discord_youtube_ok(self, timeout=6.0, threshold=0.5):
        urls = [
            "https://www.youtube.com",
            "https://youtu.be",
            "https://i.ytimg.com",
            "https://music.youtube.com",
            "https://discord.com",
            "https://cdn.discordapp.com",
            "https://discordapp.com",
            "https://media.discordapp.net",
        ]
        ok = 0
        total = len(urls)
        for url in urls:
            try:
                req = Request(url, headers={
                    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) Chrome/122.0.0.0",
                    "Accept": "text/html,application/xhtml+xml,*/*",
                })
                with urlopen(req, timeout=timeout) as resp:
                    if resp.getcode() is not None:
                        ok += 1
            except Exception:
                pass
        ratio = ok / total if total else 0
        detail = f"{ok}/{total} {int(round(ratio * 100))}%"
        return ratio >= threshold, detail

    def run_diagnostics(self):
        results = []
        try:
            out = run_hidden('sc query BFE').stdout or ""
            if "RUNNING" in out:
                results.append(("BFE (Базовый движок фильтрации)", "✅ Запущен", "ok"))
            else:
                results.append(("BFE (Базовый движок фильтрации)", "❌ Не запущен", "error"))
        except Exception:
            results.append(("BFE (Базовый движок фильтрации)", "⚠️ Не удалось проверить", "warning"))

        proxy_found = False
        try:
            for key in ["HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings", 
                        "HKLM\\SYSTEM\\CurrentControlSet\\Services\\NlaSvc\\Parameters\\Internet"]:
                out = run_hidden(f'reg query "{key}" /v ProxyEnable').stdout or ""
                if "0x1" in out:
                    proxy_found = True
                    break
            if proxy_found:
                results.append(("Прокси-сервер", "⚠️ Включён (может мешать обходу)", "warning"))
            else:
                results.append(("Прокси-сервер", "✅ Отключён", "ok"))
        except Exception:
            results.append(("Прокси-сервер", "⚠️ Не удалось проверить", "warning"))

        wd_running = False
        for svc in ["WinDivert", "WinDivert14"]:
            try:
                out = run_hidden(f'sc query {svc}').stdout or ""
                if "RUNNING" in out:
                    wd_running = True
                    break
            except Exception:
                pass
        if wd_running:
            results.append(("WinDivert", "✅ Установлен и работает", "ok"))
        else:
            results.append(("WinDivert", "⚠️ Не найден или не запущен", "warning"))

        try:
            out = run_hidden('netsh int tcp show global').stdout or ""
            if "timestamps" in out.lower():
                if "disabled" in out.lower():
                    results.append(("TCP Timestamps", "✅ Отключены (рекомендуется)", "ok"))
                else:
                    results.append(("TCP Timestamps", "⚠️ Включены (может мешать обходу)", "warning"))
            else:
                results.append(("TCP Timestamps", "ℹ️ Не удалось определить", "info"))
        except Exception:
            results.append(("TCP Timestamps", "⚠️ Не удалось проверить", "warning"))

        st = self.get_status()
        if st["service_running"]:
            results.append(("Служба zapret", f"✅ Запущена ({st.get('service_strategy', '—')})", "ok"))
        else:
            results.append(("Служба zapret", "ℹ️ Не установлена или остановлена", "info"))

        return results

    def get_conflicts_warning(self):
        warnings = []
        diag = self.run_diagnostics()
        for name, status, level in diag:
            if level == "error":
                warnings.append(f"❌ {name}: {status}")
            elif level == "warning":
                warnings.append(f"⚠️ {name}: {status}")
        try:
            procs = run_hidden('tasklist /FI "IMAGENAME eq openvpn.exe" /FI "IMAGENAME eq wireguard.exe"').stdout or ""
            if "openvpn.exe" in procs.lower() or "wireguard.exe" in procs.lower():
                warnings.append("⚠️ Обнаружен VPN (может конфликтовать с WinDivert)")
        except Exception:
            pass
        return warnings

