    def _load_files(self):
        for w in self.file_list.winfo_children():
            w.destroy()
        nice = {
            "list-general-user.txt": "➕ Добавить сайты (обход)",
            "list-exclude-user.txt": "🚫 Исключения (без обхода)",
            "ipset-exclude-user.txt": "🔢 IP-исключения",
        }
        tips = {
            "list-general-user.txt": "Сюда пиши сайты, которые нужно ОБХОДИТЬ (по одному в строке). Пример: example.com",
            "list-exclude-user.txt": "Сюда пиши сайты, которым обход НЕ нужен (банки, госуслуги и т.п.).",
            "ipset-exclude-user.txt": "IP-адреса без обхода (по одному в строке).",
        }
        for fp in self.manager.list_user_files():
            label = nice.get(fp.name, fp.name)
            tip = tips.get(fp.name, fp.name)
            btn = ctk.CTkButton(
                self.file_list, text=label, anchor="w", height=48,
                fg_color="transparent", hover_color=COLORS["card_hover"],
                command=lambda path=fp, t=tip: self._open(path, t)
            )
            btn.pack(fill="x", pady=3)

    def _open(self, path, tip=""):
        self.current_path = path
        title = str(path.name)
        self.file_label.configure(text=title, text_color=COLORS["text"])
        if tip:
            self.hint_label.configure(text=tip)
        else:
            self.hint_label.configure(text="")
        try:
            content = path.read_text(encoding="utf-8", errors="ignore")
        except Exception:
            content = ""
        self.text.delete("1.0", "end")
        self.text.insert("1.0", content)

    def _save(self):
        if not self.current_path:
            messagebox.showinfo("Файл", "Сначала выбери файл", parent=self)
            return
        try:
            self.current_path.write_text(self.text.get("1.0", "end").rstrip() + "\n", encoding="utf-8")
            if self.on_log:
                self.on_log(f"Сохранён: {self.current_path.name}")
            messagebox.showinfo("Сохранено", self.current_path.name, parent=self)
        except Exception as e:
            messagebox.showerror("Ошибка", str(e), parent=self)

    def _open_folder(self):
        try:
            os.startfile(str(self.manager.lists_path))
        except Exception as e:
            messagebox.showerror("Ошибка", str(e), parent=self)

class StartupCheckWindow(ctk.CTkToplevel):
    def __init__(self, parent, manager, strategy, on_launch, on_autopick):
        super().__init__(parent)
        self.title("Проверка стратегии")
        self.geometry("420x240")
        self.resizable(False, False)
        self.configure(fg_color=COLORS["bg"])
        self.transient(parent)
        self.grab_set()
        self.attributes("-topmost", True)
        self.manager = manager
        self.strategy = strategy
        self.on_launch = on_launch
        self.on_autopick = on_autopick
        ctk.CTkLabel(self, text=f"Проверка: {strategy['name']}",
                     font=ctk.CTkFont(size=16, weight="bold"), text_color=COLORS["text"]).pack(pady=(20, 8))
        self.status_lbl = ctk.CTkLabel(self, text="Идёт проверка...", font=ctk.CTkFont(size=14),
                                       text_color=COLORS["text_dim"])
        self.status_lbl.pack(pady=8)
        self.result_lbl = ctk.CTkLabel(self, text="", font=ctk.CTkFont(size=22, weight="bold"),
                                       text_color=COLORS["accent"])
        self.result_lbl.pack(pady=8)
        self.btn_frame = ctk.CTkFrame(self, fg_color="transparent")
        self.btn_frame.pack(pady=16)
        threading.Thread(target=self._run_test, daemon=True).start()

    def _run_test(self):
        ok, total, _ = self.manager.test_connectivity(timeout=4.5)
        score = int(round(ok / total * 100)) if total else 0
        self.after(0, lambda: self._done(score, ok, total))

    def _done(self, score, ok, total):
        # Проверяем, существует ли ещё окно
        try:
            if not self.winfo_exists():
                return
        except:
            return
        
        color = COLORS["success"] if score >= 50 else (COLORS["warning"] if score >= 30 else COLORS["danger"])
        self.status_lbl.configure(text="Результат проверки")
        self.result_lbl.configure(text=f"{score}%  ({ok}/{total})", text_color=color)
        ctk.CTkButton(self.btn_frame, text="Запустить эту", width=140, fg_color=COLORS["success"],
                      hover_color="#00a383", command=self._launch).pack(side="left", padx=8)
        ctk.CTkButton(self.btn_frame, text="Автоподбор", width=140, fg_color=COLORS["accent"],
                      hover_color=COLORS["accent_hover"], command=self._autopick).pack(side="left", padx=8)

    def _launch(self):
        self.grab_release()
        self.destroy()
        self.on_launch(self.strategy)

    def _autopick(self):
        self.grab_release()
        self.destroy()
        self.on_autopick()

