    def _restart_current_strategy(self, source):
        """Перезапускает текущую стратегию с логированием"""
        status = self.manager.get_status()
        
        if not status["service_running"] and not status["winws_running"]:
            self.log(f"⚠️ {source}: ничего не запущено, перезапуск не требуется")
            return
        
        self.log(f"🔄 {source}: перезапуск стратегии...")
        ok, msg = self.manager.restart_current_strategy()
        self.log(f"  → {msg}")
        if not ok:
            messagebox.showwarning("Перезапуск", f"Не удалось перезапустить стратегию:\n{msg}\n\nПопробуйте запустить вручную.")
        self.after(1500, self.refresh_status)

    # ========== ОСТАЛЬНЫЕ МЕТОДЫ ==========
    def log(self, text):
        ts = datetime.now().strftime("%H:%M:%S")
        self.log_box.configure(state="normal")
        self.log_box.insert("end", f"[{ts}] {text}\n")
        self.log_box.see("end")
        self.log_box.configure(state="disabled")
        log_file_write(text)

    def _initial_load(self):
        if not self.manager.is_valid():
            self.log(f"Папка не найдена: {self.zapret_path}")
            messagebox.showwarning("Папка", f"Не найдена папка zapret:\n{self.zapret_path}")
        else:
            self.log(f"Папка: {self.zapret_path}")
            self.game_var.set(self.manager.get_game_filter_mode() == "all")
            self._reload_strategies()
            self.refresh_status()
            self._schedule_status()
            self._setup_tray()
            if not HAS_TRAY:
                self.log("Трей: установи  pip install pystray pillow")
            if not HAS_TOAST:
                self.log("Уведомления: pip install winotify  (или fallback PowerShell)")
            
            self._check_startup_conflicts()
            self.after(1000, self._check_updates_startup)
            self.after(600, self._startup_after)
            self._schedule_recheck()

    def _check_updates_startup(self):
        if not self.settings.get("check_updates_on_startup", True):
            return
        skip = self.settings.get("update_skip_version")
        self._check_updates(skip_version=skip)

    def _check_updates(self, skip_version=None):
        self.log("Проверка обновлений zapret...")
        
        def worker():
            result = get_latest_zapret_version()
            if "error" in result:
                self.after(0, lambda: self.log(f"Ошибка проверки обновлений: {result['error']}"))
                return
            
            latest = result.get("version", "")
            if not latest:
                self.after(0, lambda: self.log("Не удалось получить версию"))
                return
            
            self.after(0, lambda: self.log(f"Последняя версия: v{latest}"))
            
            current = get_zapret_version_from_files(self.zapret_path)
            self.after(0, lambda: self.log(f"Текущая версия: {current}"))
            
            if current != "?":
                cmp = compare_versions(current, latest)
                if cmp >= 0:
                    self.after(0, lambda: show_toast("Zapret", f"У вас актуальная версия {current}"))
                    self.after(0, lambda: self.log(f"Актуальная версия: {current}"))
                    return
            
            if skip_version and skip_version == latest:
                self.after(0, lambda: self.log(f"Обновление v{latest} пропущено (не напоминать)"))
                return
            
            self.after(0, lambda: self._show_update_window(result, current))
        
        threading.Thread(target=worker, daemon=True).start()

    def _show_update_window(self, version_data, current_version):
        UpdateWindow(self, current_version, version_data, 
                     on_update=lambda: (self.log("Обновление zapret завершено"), self.refresh_status()),
                     zapret_path=self.zapret_path)

    def _check_startup_conflicts(self):
        warnings = self.manager.get_conflicts_warning()
        if warnings:
            msg = "Обнаружены потенциальные конфликты:\n\n" + "\n".join(warnings) + "\n\nРекомендуется устранить для стабильной работы."
            messagebox.showwarning("Внимание", msg)

    def _schedule_status(self):
        if not self._testing:
            self.refresh_status()
        self.after(5000, self._schedule_status)

    def _change_path(self):
        path = filedialog.askdirectory(title="Папка zapret")
        if path:
            self.zapret_path = path
            self.settings["zapret_path"] = path
            save_settings(self.settings)
            self.manager = ZapretManager(path)
            self.path_label.configure(text=path)
            self.game_var.set(self.manager.get_game_filter_mode() == "all")
            self._reload_strategies()
            self.refresh_status()
            self.log(f"Путь: {path}")

    def _reload_strategies(self):
        for w in self.strategies_frame.winfo_children():
            w.destroy()
        self.strategies = self.manager.find_strategies()
        for s in self.strategies:
            if s["filename"] in self.scores:
                s["score"] = self.scores[s["filename"]].get("score")
                s["score_detail"] = self.scores[s["filename"]].get("detail", "")
        self.strategies.sort(key=lambda x: (x["score"] is not None, x["score"] or -1), reverse=True)
        self.selected_strategy = None
        if not self.strategies:
            ctk.CTkLabel(self.strategies_frame, text="Стратегии не найдены",
                         text_color=COLORS["text_dim"]).pack(pady=40)
            return
        self.log(f"Стратегий: {len(self.strategies)}")
        for s in self.strategies:
            self._create_card(s)
        self._update_tray_menu()

    def _create_card(self, strat):
        card = ctk.CTkFrame(self.strategies_frame, fg_color=COLORS["card_hover"],
                            corner_radius=12, border_width=1, border_color=COLORS["border"])
        card.pack(fill="x", pady=4, padx=4)

        def select(e=None, s=strat, c=card):
            self._select(s, c)

        card.bind("<Button-1>", select)
        name_lbl = ctk.CTkLabel(card, text=strat["name"], font=ctk.CTkFont(size=14, weight="bold"),
                                text_color=COLORS["text"], anchor="w")
        name_lbl.pack(side="left", padx=(14, 6), pady=10)
        name_lbl.bind("<Button-1>", select)

        if strat.get("score") is not None:
            sc = strat["score"]
            color = COLORS["success"] if sc >= 70 else (COLORS["warning"] if sc >= 40 else COLORS["danger"])
            d = strat.get("score_detail", "")
            t = f"{sc}% {d}" if d else f"{sc}%"
            sl = ctk.CTkLabel(card, text=t, font=ctk.CTkFont(size=12, weight="bold"), text_color=color)
            sl.pack(side="left", padx=4)
            sl.bind("<Button-1>", select)

        ctk.CTkButton(card, text="Тест", width=50, height=26, fg_color=COLORS["border"],
                      command=lambda s=strat: self._quick_test(s)).pack(side="right", padx=(4, 8), pady=8)
        ctk.CTkButton(card, text="Запустить", width=90, height=26, fg_color=COLORS["accent"],
                      hover_color=COLORS["accent_hover"],
                      command=lambda s=strat: self._start(s)).pack(side="right", padx=4, pady=8)
        strat["card"] = card

    def _select(self, strat, card):
        for s in self.strategies:
            if "card" in s:
                s["card"].configure(border_color=COLORS["border"], border_width=1)
        card.configure(border_color=COLORS["accent"], border_width=2)
        self.selected_strategy = strat
        self.log(f"Выбрана: {strat['name']}")

    def _start_selected(self):
        if not self.selected_strategy:
            messagebox.showinfo("Выбор", "Кликни по карточке стратегии")
            return
        self._start(self.selected_strategy)

    def _start(self, strat):
        st = self.manager.get_status()
        if st["service_running"]:
            if not messagebox.askyesno("Служба", "Служба работает. Остановить и запустить вручную?"):
                return
            self.log(self.manager.stop_all())
        self.log(self.manager.start_strategy(strat))
        self.settings["last_strategy_filename"] = strat["filename"]
        self.settings["last_strategy_name"] = strat["name"]
        save_settings(self.settings)
        self.after(1500, self.refresh_status)

    def _stop_all(self):
        if self._testing:
            self._cancel_test()
        self.log(self.manager.stop_all())
        self.after(600, self.refresh_status)

    def _install_service(self):
        if not self.selected_strategy:
            messagebox.showinfo("Выбор", "Выбери стратегию")
            return
        s = self.selected_strategy
        if not messagebox.askyesno("Служба", f"Установить «{s['name']}» как службу?"):
            return
        self.log(f"Установка: {s['name']}...")

        def work():
            ok, msg = self.manager.install_as_service(s)
            self.settings["last_strategy_filename"] = s["filename"]
            self.settings["last_strategy_name"] = s["name"]
            save_settings(self.settings)
            self.after(0, lambda: (
                self.log(msg), self.refresh_status(),
                messagebox.showinfo("Готово", msg) if ok else messagebox.showerror("Ошибка", msg)
            ))
        threading.Thread(target=work, daemon=True).start()

    def _remove_service(self):
        if not messagebox.askyesno("Удаление", "Удалить службу zapret?"):
            return
        self.log(self.manager.remove_service())
        self.after(600, self.refresh_status)

    def _quick_test(self, strat):
        self.log(f"Быстрый тест: {strat['name']}...")

        def work():
            self.manager.stop_all()
            time.sleep(0.8)
            self.manager.start_strategy(strat)
            time.sleep(3.0)
            ok, total, _ = self.manager.test_connectivity(timeout=4.0)
            score = int(round(ok / total * 100)) if total else 0
            detail = f"{ok}/{total}"
            self.scores[strat["filename"]] = {"score": score, "detail": detail, "name": strat["name"]}
            save_scores(self.scores)
            self.after(0, lambda: self._quick_test_done(strat, score, detail))

        threading.Thread(target=work, daemon=True).start()

    def _quick_test_done(self, strat, score, detail):
        self.log(f"  → {strat['name']}: {score}% ({detail})")
        self._reload_strategies()
        self.refresh_status()
        messagebox.showinfo("Тест", f"{strat['name']}\n{score}% ({detail})")

    def _cancel_test(self):
        self._stop_test[0] = True
        self.log("Остановка проверки...")
        self.manager.stop_all()

    def _auto_find_best(self):
        if self._testing:
            return
        stop_dy = messagebox.askyesno(
            "Умный автоподбор",
            "Останавливаться на первой стратегии,\n"
            "где YouTube + Discord доступны ≥ 50%?\n\n"
            "8 адресов: youtube, youtu.be, ytimg, music.yt,\n"
            "discord, cdn.discordapp, discordapp, media.discordapp\n\n"
            "Да — стоп при ≥4 из 8\n"
            "Нет — полный прогон всех стратегий"
        )
        self._testing = True
        self._stop_test[0] = False
        self.btn_autofind.configure(state="disabled")
        self.btn_stop_test.configure(state="normal")
        mode = "Discord+YouTube" if stop_dy else "полный"
        self.log(f"=== Автоподбор ({mode}) ===")

        def worker():
            results = {}
            total = len(self.strategies)
            found = None
            for i, strat in enumerate(self.strategies, 1):
                if self._stop_test[0]:
                    self.after(0, lambda: self.log("Прервано"))
                    break
                self.after(0, lambda s=strat, n=i, t=total: self.log(f"[{n}/{t}] {s['name']}..."))
                self.manager.stop_all()
                time.sleep(1.0)
                if self._stop_test[0]:
                    break
                self.manager.start_strategy(strat)
                time.sleep(4.5)
                if self._stop_test[0]:
                    break

                if stop_dy:
                    dy_ok, dy_detail = self.manager.discord_youtube_ok(timeout=4.0, threshold=0.5)
                    ok, tot, _ = self.manager.test_connectivity(timeout=3.0, stop_flag=self._stop_test)
                    score = int(round(ok / tot * 100)) if tot else 0
                    results[strat["filename"]] = {
                        "score": score, "detail": f"{ok}/{tot}", "name": strat["name"]
                    }
                    if dy_ok:
                        found = strat
                        self.after(0, lambda s=strat, d=dy_detail: self.log(
                            f"  → {s['name']}: D+YT OK ({d}) — стоп"
                        ))
                        break
                    else:
                        self.after(0, lambda s=strat, d=dy_detail, sc=score: self.log(
                            f"  → {s['name']}: {sc}% | D+YT {d} (<50%)"
                        ))
                else:
                    ok, tot, _ = self.manager.test_connectivity(timeout=4.5, stop_flag=self._stop_test)
                    score = int(round(ok / tot * 100)) if tot else 0
                    results[strat["filename"]] = {
                        "score": score, "detail": f"{ok}/{tot}", "name": strat["name"]
                    }
                    self.after(0, lambda s=strat, sc=score, d=f"{ok}/{tot}": self.log(
                        f"  → {s['name']}: {sc}% ({d})"
                    ))

                self.manager.stop_all()
                time.sleep(0.5)

            self.scores.update(results)
            save_scores(self.scores)
            self.after(0, lambda: self._on_auto_done(results, found, self._stop_test[0]))

        threading.Thread(target=worker, daemon=True).start()

    def _on_auto_done(self, results, found, cancelled):
        self._testing = False
        self.btn_autofind.configure(state="normal")
        self.btn_stop_test.configure(state="disabled")
        self.log("=== Автоподбор завершён ===")
        self._reload_strategies()
        self.refresh_status()
        if cancelled:
            return
        if found:
            show_toast("Zapret", f"Найдена рабочая: {found['name']}")
            if messagebox.askyesno("Найдена", f"Рабочая стратегия: {found['name']}\n\nЗапустить её?"):
                self._start(found)
        elif results:
            best = max(results.items(), key=lambda x: x[1]["score"])
            show_toast("Zapret", f"Лучшая: {best[1]['name']} ({best[1]['score']}%)")
            messagebox.showinfo("Результат", f"Лучшая: {best[1]['name']}\n{best[1]['score']}%")

    def _open_lists(self):
        ListsEditorWindow(self, self.manager, on_log=self.log)

    def _open_diagnostics(self):
        DiagnosticsWindow(self, self.manager, on_log=self.log)

    def _open_log_file(self):
        try:
            if not LOG_FILE.exists():
                LOG_FILE.write_text("", encoding="utf-8")
            os.startfile(str(LOG_FILE))
        except Exception as e:
            messagebox.showerror("Лог", str(e))

    def _open_settings(self):
        SettingsWindow(
            self, self.manager, self.settings,
            on_change=lambda: (self.log("Настройки сохранены"), self._schedule_recheck())
        )

    def _startup_after(self):
        if not self.settings.get("check_last_on_startup"):
            return
        fn = self.settings.get("last_strategy_filename")
        if not fn:
            return
        strat = next((s for s in self.strategies if s["filename"] == fn), None)
        if not strat:
            self.log(f"Последняя стратегия не найдена: {fn}")
            return
        self.log(f"Проверка при запуске: {strat['name']}")
        StartupCheckWindow(
            self, self.manager, strat,
            on_launch=lambda s: self._start(s),
            on_autopick=self._auto_find_best,
        )

    def _schedule_recheck(self):
        if self._recheck_job:
            try:
                self.after_cancel(self._recheck_job)
            except Exception:
                pass
            self._recheck_job = None
        if not self.settings.get("recheck_enabled"):
            return
        hours = max(1, min(24, int(self.settings.get("recheck_hours", 6))))
        ms = hours * 3600 * 1000
        self._recheck_job = self.after(ms, self._do_recheck)
        self.log(f"Фоновая перепроверка: каждые {hours} ч")

    def _do_recheck(self):
        def work():
            ok, total, _ = self.manager.test_connectivity(timeout=4.0)
            score = int(round(ok / total * 100)) if total else 0
            prev = self.settings.get("last_recheck_score")
            self.settings["last_recheck_score"] = score
            save_settings(self.settings)
            if prev is not None and score < prev:
                show_toast(
                    "Zapret: доступность упала",
                    f"Было {prev}%, стало {score}%. Возможно, смените стратегию."
                )
                self.after(0, lambda: self.log(f"Фон: {prev}% → {score}% (упало)"))
            else:
                self.after(0, lambda: self.log(f"Фон: проверка OK ({score}%)"))
            self.after(0, self._schedule_recheck)
        threading.Thread(target=work, daemon=True).start()

    # ========== ТРЕЙ ==========
    def _make_tray_image(self):
        img = Image.new("RGBA", (64, 64), (0, 0, 0, 0))
        d = ImageDraw.Draw(img)
        d.ellipse([4, 4, 60, 60], fill=(108, 92, 231, 255))
        d.ellipse([18, 18, 46, 46], fill=(0, 184, 148, 255))
        return img

    def _setup_tray(self):
        if not HAS_TRAY:
            return False
        if self._tray_icon is not None:
            return True
        try:
            def on_open(*args):
                self.after(0, self._show_from_tray)

            def on_stop(*args):
                self.after(0, self._stop_all)

            def on_quit(*args):
                self.after(0, self._quit_app)

            menu = pystray.Menu(
                pystray.MenuItem("Открыть окно", on_open, default=True),
                pystray.MenuItem("Остановить всё", on_stop),
                pystray.Menu.SEPARATOR,
                pystray.MenuItem("Выход", on_quit),
            )
            icon = pystray.Icon("zcc", self._make_tray_image(), APP_NAME, menu)
            self._tray_icon = icon

            def run_icon():
                try:
                    icon.run()
                except Exception:
                    pass

            threading.Thread(target=run_icon, daemon=True).start()
            time.sleep(0.3)
            self.log("Трей запущен (иконка возле часов, иногда под стрелкой ^)")
            return True
        except Exception as e:
            self.log(f"Трей ошибка: {e}")
            self._tray_icon = None
            return False

    def _update_tray_menu(self):
        pass

    def _hide_to_tray(self):
        ok = self._setup_tray()
        if not ok or not self._tray_icon:
            messagebox.showwarning(
                "Трей",
                "Иконка в трее недоступна.\n"
                "Установи: pip install pystray pillow\n"
                "Или закрой программу через «Выход»."
            )
            return
        self.withdraw()
        try:
            self._tray_icon.visible = True
        except Exception:
            pass
        show_toast(APP_NAME, "Свёрнуто в трей — иконка возле часов (или под ^)")

    def _show_from_tray(self):
        self.deiconify()
        self.lift()
        self.focus_force()
        try:
            self.attributes("-topmost", True)
            self.after(200, lambda: self.attributes("-topmost", False))
        except Exception:
            pass

    def _on_close(self):
        if HAS_TRAY:
            if self._setup_tray() and self._tray_icon:
                self._hide_to_tray()
                return
        self._quit_app()

    def _quit_app(self):
        if self._tray_icon:
            try:
                self._tray_icon.stop()
            except Exception:
                pass
        self.destroy()
        try:
            sys.exit(0)
        except Exception:
            pass

    def refresh_status(self):
        if not self.manager.is_valid():
            self.status_service.configure(text="● Сервис: нет папки", text_color=COLORS["danger"])
            self.status_strategy.configure(text="● Стратегия: —", text_color=COLORS["text_dim"])
            self.status_winws.configure(text="● WinWS: —", text_color=COLORS["text_dim"])
            return
        st = self.manager.get_status()
        if st["service_running"]:
            self.status_service.configure(text="● Сервис: Запущен", text_color=COLORS["success"])
        else:
            self.status_service.configure(text="● Сервис: Остановлен", text_color=COLORS["text_dim"])
        name = st.get("active_name") or st.get("service_strategy")
        if name:
            d = str(name)
            if d.lower().startswith("general"):
                d = d[7:].strip(" ()") or d
            self.status_strategy.configure(text=f"● Стратегия: {d}", text_color=COLORS["text"])
        else:
            self.status_strategy.configure(text="● Стратегия: —", text_color=COLORS["text_dim"])
        if st["winws_running"]:
            self.status_winws.configure(text="● WinWS: Работает", text_color=COLORS["success"])
        else:
            self.status_winws.configure(text="● WinWS: Нет", text_color=COLORS["text_dim"])

def main():
    if not is_admin():
        root = ctk.CTk()
        root.withdraw()
        ok = messagebox.askokcancel("Админ", "Нужны права администратора.\nUAC → Да")
        root.destroy()
        if not ok:
            sys.exit(0)
        if not run_as_admin():
            sys.exit(0)
    missing = []
    if not HAS_TRAY:
        missing.append("pystray pillow")
    if not HAS_TOAST:
        missing.append("winotify")
    if missing:
        print("Для трея/уведомлений:  pip install " + " ".join(missing))

    App().mainloop()

if __name__ == "__main__":
    main()
