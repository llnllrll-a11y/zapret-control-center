                                         font=ctk.CTkFont(size=12), text_color=COLORS["text_dim"])
        self.progress_lbl.pack(pady=4)

    def _do_update(self):
        self.btn_update.configure(state="disabled")
        self.btn_later.configure(state="disabled")
        self.progress_var.set("Подготовка...")

        def worker():
            result, msg = download_and_update_zapret(
                self.zapret_path,
                self.new_version["zip_url"],
                progress_callback=self._update_progress
            )
            self.after(0, lambda: self._update_done(result, msg))

        threading.Thread(target=worker, daemon=True).start()

    def _update_progress(self, text, percent):
        self.after(0, lambda: self.progress_var.set(f"{text} ({percent}%)"))

    def _update_done(self, result, msg):
        if result:
            self.progress_var.set("✅ " + msg)
            show_toast("Zapret", "Обновление установлено успешно!")
            self.after(1500, self.destroy)
            if self.on_update:
                self.on_update()
        else:
            self.progress_var.set("❌ " + msg)
            messagebox.showerror("Ошибка обновления", msg)
            self.btn_update.configure(state="normal")
            self.btn_later.configure(state="normal")

