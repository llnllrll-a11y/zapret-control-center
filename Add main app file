def parse_version(v):
    if not v:
        return (0, 0, 0)
    v = v.lstrip("v")
    parts = re.findall(r'\d+', v)
    return tuple(int(x) for x in parts[:3])

def compare_versions(v1, v2):
    v1_t = parse_version(v1)
    v2_t = parse_version(v2)
    if v1_t < v2_t:
        return -1
    elif v1_t > v2_t:
        return 1
    return 0

def get_zapret_version_from_files(zapret_path):
    zapret_path = Path(zapret_path)
    service_bat = zapret_path / "service.bat"
    
    if not service_bat.exists():
        return "?"
    
    try:
        content = service_bat.read_text(encoding="utf-8", errors="ignore")
        m = re.search(r'[Vv]?(\d+\.\d+\.\d+)', content)
        if m:
            return m.group(1)
    except Exception:
        pass
    
    try:
        readme = zapret_path / "readme.md"
        if readme.exists():
            content = readme.read_text(encoding="utf-8", errors="ignore")
            m = re.search(r'[Vv]?(\d+\.\d+\.\d+)', content)
            if m:
                return m.group(1)
    except Exception:
        pass
    
    return "?"

def get_latest_zapret_version():
    try:
        req = Request(GITHUB_API_URL, headers={
            "User-Agent": "ZapretControlCenter/2.0",
            "Accept": "application/json"
        })
        with urlopen(req, timeout=10) as resp:
            data = json.loads(resp.read().decode())
            tag = data.get("tag_name", "")
            if tag.startswith("v"):
                tag = tag[1:]
            assets = data.get("assets", [])
            zip_asset = None
            for asset in assets:
                if asset.get("name", "").endswith(".zip"):
                    zip_asset = asset
                    break
            return {
                "version": tag,
                "zip_url": zip_asset["browser_download_url"] if zip_asset else None,
                "zip_name": zip_asset["name"] if zip_asset else None,
                "html_url": data.get("html_url", ""),
                "published_at": data.get("published_at", ""),
                "body": data.get("body", "")[:500]
            }
    except Exception as e:
        return {"error": str(e)}

def stop_all_zapret_processes():
    commands = [
        'net stop zapret 2>nul',
