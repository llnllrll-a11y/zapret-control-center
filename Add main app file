class DiagnosticsWindow(ctk.CTkToplevel):
    def __init__(self, parent, manager, on_log=None):
        super().__init__(parent)
        self.manager = manager
        self.on_log = on_log
        self.title("Диагностика")
        self.geometry("600x500")
        self.configure(fg_color=COLORS["bg"])
        self.transient(parent)
        self.grab_set()

        ctk.CTkLabel(self, text="Диагностика системы", font=ctk.CTkFont(size=18, weight="bold")).pack(pady=12)
        
        self.results_frame = ctk.CTkScrollableFrame(self, fg_color=COLORS["card"], corner_radius=12)
        self.results_frame.pack(fill="both", expand=True, padx=16, pady=8)

        ctk.CTkButton(self, text="Обновить", width=120, fg_color=COLORS["accent"],
                      command=self._run_diagnostics).pack(pady=8)
        ctk.CTkButton(self, text="Закрыть", width=120, fg_color=COLORS["border"],
                      command=self.destroy).pack(pady=4)

        self._run_diagnostics()

    def _run_diagnostics(self):
        for w in self.results_frame.winfo_children():
            w.destroy()

        results = self.manager.run_diagnostics()
        for name, status, level in results:
            color = COLORS["success"] if level == "ok" else (COLORS["warning"] if level == "warning" else COLORS["text_dim"])
            lbl = ctk.CTkLabel(self.results_frame, text=f"{name}: {status}", 
                               font=ctk.CTkFont(size=14), text_color=color, anchor="w", justify="left")
            lbl.pack(fill="x", padx=12, pady=4)

        warnings = self.manager.get_conflicts_warning()
        if warnings:
            ctk.CTkLabel(self.results_frame, text="\n⚠️ Рекомендации:", 
                         font=ctk.CTkFont(size=14, weight="bold"), text_color=COLORS["warning"]).pack(anchor="w", padx=12, pady=(12, 4))
            for w in warnings:
                lbl = ctk.CTkLabel(self.results_frame, text=w, 
                                   font=ctk.CTkFont(size=13), text_color=COLORS["warning"], anchor="w", justify="left", wraplength=500)
                lbl.pack(fill="x", padx=12, pady=2)

        if self.on_log:
            self.on_log("Диагностика выполнена")

